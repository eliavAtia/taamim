{
  "name": "taamim-monorepo",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "description": "Ta'amim (טעמים) - Mobile App for Moroccan Cantillation Learning (Duolingo Style)",
  "workspaces": [
    "frontend/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@taamim/api run start:dev",
    "dev:mobile": "npm --workspace=@taamim/mobile run start",
    "dev:audio": "cd backend/audio-engine && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "build:packages": "npm --workspace=@taamim/shared-types run build",
    "build:api": "npm --workspace=@taamim/api run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prisma:generate": "npm --workspace=@taamim/api run prisma:generate",
    "prisma:migrate": "npm --workspace=@taamim/api run prisma:migrate",
    "prisma:studio": "npm --workspace=@taamim/api run prisma:studio"
  },
  "keywords": [
    "cantillation",
    "taamim",
    "moroccan-tradition",
    "react-native",
    "expo",
    "nestjs",
    "fastapi",
    "dsp",
    "gamification"
  ],
  "author": "Ta'amim Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "react-native-worklets": "^0.10.1"
  }
}
